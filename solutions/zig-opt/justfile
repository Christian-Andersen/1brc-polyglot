alias b := build
alias c := check
alias r := run

default: check run

check:
    prek run --all-files

run:
    zig build run

perf:
    zig build
    perf record -g ./zig-out/bin/main
    perf report

time runs="1": build
    hyperfine --shell=none --warmup 1 --runs {{ runs }} ./zig-out/bin/main ./zig-out/bin/main-old

build:
    zig build --release=fast

bench:
    ./zig-out/bin/main
